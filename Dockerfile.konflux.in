# Model/data files come from a pre-published, ProdSec-scanned "modelcar" OCI
# image. The modelcar stores every file under /models in the .cache-relative
# layout OGX expects (docling/huggingface/tiktoken), including the HF hub
# refs/main marker. Referencing it as a build stage lets Konflux resolve/pull it
# during the pre-pull phase (before network isolation), so the copy below stays
# hermetic.
ARG OGX_MODELCAR_IMAGE
FROM ${OGX_MODELCAR_IMAGE} AS modelcar

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG OGX_VERSION
ARG TARGETARCH

LABEL com.redhat.component="ogx-cpu-rhel9-container" \
      name="ogx/cpu-rhel9" \
      description="OGX ${OGX_VERSION} for CPU on RHEL 9" \
      summary="OGX for CPU" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.k8s.display-name="OGX for CPU" \
      io.k8s.description="OGX ${OGX_VERSION} for CPU on RHEL 9" \
      io.openshift.expose-services="" \
      com.redhat.license_terms="https://www.redhat.com/en/about/eulas#RHAIIS" \
      com.redhat.aiplatform.image="${BASE_IMAGE}"

{config_labels}

COPY distribution/requirements-lock-konflux.txt ${APP_ROOT}/requirements-lock-konflux.txt

RUN source /cachi2/cachi2.env \
    && uv pip install --no-index --find-links "${PIP_FIND_LINKS}" \
       -r ${APP_ROOT}/requirements-lock-konflux.txt

USER 0
# install missing RPMs (online, requires subscription)
# RUN ${APP_ROOT}/lib/tools/fromager-rpm-check.py --check-dnf -y --dnf-clean
# TODO: check if public-repos.sh is still needed
RUN ${APP_ROOT}/lib/tools/public-repos.sh
USER ${CNB_USER_ID}:${CNB_GROUP_ID}

# scan for missing RPMs (offline), missing libraries / symbols, and selftest
# AIPCC-3688: do not scan the container for missing libraries and symbols
# re-add ${APP_ROOT}/lib/tools/scanlibs.py below once milvus-lite build is fixed
# TODO: check if selftest.py is still needed
RUN ${APP_ROOT}/lib/tools/fromager-rpm-check.py --check-rpmdb \
    && ${APP_ROOT}/lib/tools/selftest.py

# Model/data artifacts from the modelcar build stage. Files are stored
# .cache-relative under /models, so their contents land under ${APP_ROOT}/.cache
# at the paths OGX expects (including the HF hub refs/main marker, which the
# modelcar provides directly). Preserve CNB-user ownership, since the server
# reads the cache at runtime as the CNB user.
COPY --from=modelcar --chown=${CNB_USER_ID}:${CNB_GROUP_ID} /models ${APP_ROOT}/.cache
# Drop the modelcar's docs, then verify the expected model trees are present
# (hard-fails a bad/empty modelcar rather than shipping a broken image).
RUN rm -f ${APP_ROOT}/.cache/README.md ${APP_ROOT}/.cache/modelcard.md \
    && for d in docling huggingface tiktoken; do \
         { [ -d "${APP_ROOT}/.cache/${d}" ] && [ -n "$(ls -A "${APP_ROOT}/.cache/${d}")" ]; } \
           || { echo "ERROR: model/data cache missing or empty: .cache/${d}" >&2; exit 1; }; \
       done
ENV DOCLING_ARTIFACTS_PATH="${APP_ROOT}/.cache/docling/models"
ENV HF_HOME="${APP_ROOT}/.cache/huggingface"
ENV TIKTOKEN_CACHE_DIR="${APP_ROOT}/.cache/tiktoken"

COPY distribution/config.yaml ${APP_ROOT}/config.yaml
COPY --chmod=755 distribution/entrypoint.sh ${APP_ROOT}/entrypoint.sh

ENTRYPOINT [ "/opt/app-root/entrypoint.sh" ]
